# --- Application ---
APP_NAME=Hackgenix Feedback Intelligence API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL is required. Do not point this at SQLite.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hackgenix

# --- LLM provider (Phase 3A) ---
# LLM_PROVIDER selects the backend. Only "gemini" is implemented so far.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Optional, shown with their defaults:
# LLM_CONFIDENCE_REVIEW_THRESHOLD=0.5
# LLM_TIMEOUT_SECONDS=30

# --- Embedding provider (Phase 3B-1) ---
# Reuses GEMINI_API_KEY above — no separate embedding key.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# --- CORS (frontend integration) ---
# Comma-separated list of allowed origins. Defaults (if unset) already
# cover the common local dev server ports (Vite 5173, CRA/Next.js 3000) —
# uncomment and edit only if your frontend runs somewhere else.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
